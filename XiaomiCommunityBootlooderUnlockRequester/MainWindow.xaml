<Window x:Class="XiaomiCommunityBootlooderUnlockRequester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XiaomiCommunityBootlooderUnlockRequester"
        mc:Ignorable="d"
         Title="Xiaomi Global Bootloader Turbo Tool" Height="450" Width="600">
    <Border Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Action Switches -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <Button x:Name="btnStart" Content="Arm Core System" Width="150" Height="35" Click="BtnStart_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="btnStop" Content="Disarm Engine" Width="150" Height="35" Margin="10,0,0,0" Click="BtnStop_Click" Background="#F44336" Foreground="White" FontWeight="Bold"/>
            </StackPanel>

            <!-- Row 1: Manual Time Schedulers Configuration -->
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Target Time (24h format): " VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>

                <TextBox x:Name="txtHour" Text="21" Width="40" Height="25" TextAlignment="Center" VerticalContentAlignment="Center" Margin="5,0"/>
                <TextBlock Text=":" VerticalAlignment="Center"/>

                <TextBox x:Name="txtMin" Text="29" Width="40" Height="25" TextAlignment="Center" VerticalContentAlignment="Center" Margin="5,0"/>
                <TextBlock Text=":" VerticalAlignment="Center"/>

                <TextBox x:Name="txtSec" Text="58" Width="40" Height="25" TextAlignment="Center" VerticalContentAlignment="Center" Margin="5,0"/>

                <TextBlock Text="Ms Shift:" VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,5,0"/>
                <TextBox x:Name="txtMs" Text="400" Width="40" Height="25" TextAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Row 2: Console Terminal Visualizer -->
            <TextBox x:Name="txtLog" Grid.Row="2" Background="#1E1E1E" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Border>
</Window>
